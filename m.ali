<th>Amount</th>
<th>Type</th>
<th>Transaction ID</th>
<th>Status</th>
<th>Action</th>
</tr>

{% for p in payments %}

<tr>

<td>{{ p["payment_id"] }}</td>

<td>{{ p["student_name"] }}</td>

<td>{{ p["application_id"] }}</td>

<td>Rs. {{ p["amount"] }}</td>

<td>{{ p["payment_type"] }}</td>

<td>{{ p["transaction_id"] }}</td>

<td>
<strong>{{ p["status"] }}</strong>
</td>

<td>

<a class="verify"
href="/payment-status/{{ p['id'] }}/Verified">
Verify
</a>

<a class="reject"
href="/payment-status/{{ p['id'] }}/Rejected">
Reject
</a>

</td>

</tr>

{% endfor %}

</table>

</div>


<!-- MESSAGES -->

<div class="block">

<h2>📩 Contact Messages</h2>

<table>

<tr>
<th>Message ID</th>
<th>Name</th>
<th>Phone</th>
<th>Email</th>
<th>Subject</th>
<th>Message</th>
</tr>

{% for m in messages %}

<tr>

<td>{{ m["message_id"] }}</td>
<td>{{ m["name"] }}</td>
<td>{{ m["phone"] }}</td>
<td>{{ m["email"] }}</td>
<td>{{ m["subject"] }}</td>
<td>{{ m["message"] }}</td>

</tr>

{% endfor %}

</table>

</div>


</div>

</body>

</html>

"""


# =========================================================
# MAIN HUGE WEBSITE
# =========================================================

HOME_PAGE = """

<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
>

<title>{{ school_name }}</title>

<style>

/* =====================================================
   GLOBAL
===================================================== */

* {
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html {
    scroll-behavior:smooth;
}

body {
    font-family:
    Arial,
    Helvetica,
    sans-serif;

    background:#f4f7fb;
    color:#172033;
}

a {
    text-decoration:none;
}

section {
    padding:90px 6%;
}

.section-title {
    text-align:center;
    font-size:42px;
    margin-bottom:15px;
}

.section-text {
    text-align:center;
    max-width:750px;
    margin:0 auto 45px;
    color:#657083;
    line-height:1.8;
}


/* =====================================================
   NAVIGATION
===================================================== */

.navbar {

    position:sticky;
    top:0;

    z-index:9999;

    background:
    rgba(4,20,40,.96);

    backdrop-filter:blur(15px);

    padding:17px 5%;

    display:flex;

    justify-content:space-between;

    align-items:center;

    box-shadow:
    0 5px 30px
    rgba(0,0,0,.15);
}

.logo {

    color:white;

    font-size:20px;

    font-weight:bold;
}

.nav-links {

    display:flex;

    flex-wrap:wrap;

    justify-content:flex-end;
}

.nav-links a {

    color:white;

    margin:5px 9px;

    font-size:13px;

    transition:.2s;
}

.nav-links a:hover {

    color:#58d9ff;
}


/* =====================================================
   HERO
===================================================== */

.hero {

    min-height:700px;

    display:flex;

    align-items:center;

    color:white;

    padding:100px 7%;

    background:

    radial-gradient(
        circle at 15% 25%,
        rgba(0,220,255,.35),
        transparent 28%
    ),

    radial-gradient(
        circle at 85% 75%,
        rgba(0,255,160,.25),
        transparent 28%
    ),

    linear-gradient(
        135deg,
        #03182f,
        #075985,
        #043b59
    );

    position:relative;

    overflow:hidden;
}

.hero:after {

    content:"";

    position:absolute;

    width:500px;
    height:500px;

    border-radius:50%;

    border:1px solid
    rgba(255,255,255,.15);

    right:-200px;
    top:-200px;
}

.hero-content {

    max-width:900px;

    position:relative;

    z-index:2;
}

.badge {

    display:inline-block;

    padding:10px 18px;

    border-radius:50px;

    background:
    rgba(255,255,255,.12);

    border:
    1px solid
    rgba(255,255,255,.2);

    margin-bottom:25px;
}

.hero h1 {

    font-size:
    clamp(42px,7vw,80px);

    line-height:1.02;

    margin-bottom:25px;
}

.hero p {

    font-size:20px;

    line-height:1.8;

    max-width:750px;
}

.hero-buttons {

    margin-top:35px;
}

.btn {

    display:inline-block;

    padding:15px 25px;

    border-radius:12px;

    margin:5px;

    font-weight:bold;

    border:0;

    cursor:pointer;
}

.btn-light {

    background:white;

    color:#075985;
}

.btn-dark {

    background:#061a35;

    color:white;
}


/* =====================================================
   STATS
===================================================== */

.stats {

    margin-top:-55px;

    position:relative;

    z-index:10;

    padding:0 6%;

    display:grid;

    grid-template-columns:
    repeat(4,1fr);

    gap:20px;
}

.stat {

    background:white;

    padding:32px;

    border-radius:22px;

    text-align:center;

    box-shadow:
    0 15px 45px
    rgba(0,0,0,.10);
}

.stat h2 {

    color:#087ea4;

    font-size:40px;

    margin-bottom:8px;
}


/* =====================================================
   CARDS
===================================================== */

.grid {

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(230px,1fr));

    gap:25px;
}

.card {

    background:white;

    padding:32px;

    border-radius:24px;

    box-shadow:
    0 12px 40px
    rgba(0,0,0,.07);

    transition:.3s;
}

.card:hover {

    transform:
    translateY(-8px);
}

.card-icon {

    font-size:40px;

    margin-bottom:15px;
}

.card h3 {

    color:#075985;

    margin-bottom:12px;
}

.card p {

    color:#667085;

    line-height:1.7;
}


/* =====================================================
   FORMS
===================================================== */

.form-section {

    background:
    linear-gradient(
        180deg,
        #eef7fb,
        #f8fafc
    );
}

.form-box {

    max-width:950px;

    margin:auto;

    background:white;

    padding:40px;

    border-radius:28px;

    box-shadow:
    0 20px 60px
    rgba(0,0,0,.08);
}

.form-grid {

    display:grid;

    grid-template-columns:
    repeat(2,1fr);

    gap:5px 20px;
}

.form-full {

    grid-column:
    1 / -1;
}

label {

    display:block;

    font-weight:bold;

    margin-top:12px;

    margin-bottom:6px;
}

input,
select,
textarea {

    width:100%;

    padding:14px;

    border:
    1px solid
    #d9e0e8;

    border-radius:11px;

    font-size:15px;

    outline:none;
}

input:focus,
select:focus,
textarea:focus {

    border-color:#087ea4;

    box-shadow:
    0 0 0 3px
    rgba(8,126,164,.1);
}

textarea {

    min-height:120px;

    resize:vertical;
}

.submit-btn {

    width:100%;

    margin-top:22px;

    padding:16px;

    border:0;

    border-radius:12px;

    background:
    linear-gradient(
        135deg,
        #075985,
        #087ea4
    );

    color:white;

    font-size:16px;

    font-weight:bold;

    cursor:pointer;
}


/* =====================================================
   PAYMENT
===================================================== */

.payment {

    color:white;

    background:
    linear-gradient(
        135deg,
        #063d2d,
        #087f5b
    );
}

.payment .section-text {

    color:#d8fff0;
}

.payment-number {

    font-size:30px;

    font-weight:bold;

    margin:15px 0;

    letter-spacing:2px;
}

.payment-card {

    background:white;

    color:#172033;

    padding:35px;

    border-radius:25px;

    box-shadow:
    0 15px 40px
    rgba(0,0,0,.15);
}


/* =====================================================
   CONTACT
===================================================== */

.contact-card {

    text-align:center;
}

.contact-number {

    font-size:22px;

    font-weight:bold;

    color:#075985;

    margin:12px 0;
}


/* =====================================================
   FOOTER
===================================================== */

footer {

    background:#04182e;

    color:white;

    padding:60px 6%;

    text-align:center;
}

footer h2 {

    margin-bottom:12px;
}

footer p {

    color:#b9c6d5;

    margin:7px;
}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:850px) {

    .navbar {

        flex-direction:column;

        gap:15px;
    }

    .nav-links {

        justify-content:center;
    }

    .stats {

        grid-template-columns:
        repeat(2,1fr);

        margin-top:20px;
    }

    .form-grid {

        grid-template-columns:1fr;
    }

    .form-full {

        grid-column:auto;
    }
}

@media(max-width:500px) {

    .stats {

        grid-template-columns:1fr;
    }

    section {

        padding:65px 5%;
    }

    .form-box {

        padding:25px;
    }
}

</style>

</head>


<body>


<!-- =====================================================
     NAVIGATION
===================================================== -->

<nav class="navbar">

<div class="logo">
🏫 {{ school_name }}
</div>

<div class="nav-links">

<a href="#home">Home</a>

<a href="#about">About</a>

<a href="#classes">Classes</a>

<a href="#admission">Admission</a>

<a href="#registration">Registration</a>

<a href="#teachers">Teachers</a>

<a href="#demo">Teacher Demo</a>

<a href="#payment">Payment</a>

<a href="#contact">Contact</a>

</div>

</nav>


<!-- =====================================================
     HOME BLOCK
===================================================== -->

<section class="hero" id="home">

<div class="hero-content">

<div class="badge">
PRIVATE SCHOOL • PLAY GROUP TO CLASS 7
</div>

<h1>
{{ school_name }}
</h1>

<p>
Quality education, modern learning,
discipline and confidence for the next generation.
</p>

<div class="hero-buttons">

<a class="btn btn-light"
href="#admission">
🎓 Apply Online
</a>

<a class="btn btn-dark"
href="#payment">
💳 JazzCash Payment
</a>

</div>

</div>

</section>


<!-- =====================================================
     STATS BLOCK
===================================================== -->

<div class="stats">

<div class="stat">
<h2>200+</h2>
<p>Students</p>
</div>

<div class="stat">
<h2>10</h2>
<p>Learning Levels</p>
</div>

<div class="stat">
<h2>7</h2>
<p>School Classes</p>
</div>

<div class="stat">
<h2>24/7</h2>
<p>Online Applications</p>
</div>

</div>


<!-- =====================================================
     ABOUT BLOCK
===================================================== -->

<section id="about">

<h2 class="section-title">
About Our School
</h2>

<p class="section-text">
{{ school_name }} is a private school providing
education from Play Group to Class 7.
Parents can use our online services from home.
</p>

<div class="grid">

<div class="card">

<div class="card-icon">🏫</div>

<h3>Private School</h3>

<p>
A dedicated private-school learning environment
for students and families.
</p>

</div>


<div class="card">

<div class="card-icon">🎓</div>

<h3>Quality Education</h3>

<p>
Focus on academic learning, discipline,
confidence and communication.
</p>

</div>


<div class="card">

<div class="card-icon">💻</div>

<h3>Online Services</h3>

<p>
Parents can submit applications and payment
information online from home.
</p>

</div>


<div class="card">

<div class="card-icon">🌟</div>

<h3>Student Development</h3>

<p>
We aim to develop knowledge, confidence,
creativity and responsible habits.
</p>

</div>

</div>

</section>


<!-- =====================================================
     CLASSES BLOCK
===================================================== -->

<section id="classes"
style="background:#eef6fa;">

<h2 class="section-title">
Our Classes
</h2>

<p class="section-text">
Our school offers education from Play Group
through Class 7. Foundation is not included.
</p>

<div class="grid">

{% for c in classes %}

<div class="card">

<div class="card-icon">
📚
</div>

<h3>
{{ c }}
</h3>

<p>
Student-focused learning and academic development.
</p>

</div>

{% endfor %}

</div>

</section>


<!-- =====================================================
     ADMISSION BLOCK
===================================================== -->

<section id="admission"
class="form-section">

<h2 class="section-title">
Online Admission
</h2>

<p class="section-text">
Parents can complete the admission application
from home.
</p>

<div class="form-box">

<form
method="POST"
action="/submit-admission"
>

<div class="form-grid">

<div>

<label>Student Name *</label>

<input
name="student_name"
required
placeholder="Student full name"
>

</div>


<div>

<label>Father Name *</label>

<input
name="father_name"
required
placeholder="Father full name"
>

</div>


<div>

<label>Gender</label>

<select name="gender">

<option value="">
Select
</option>

<option>
Male
</option>

<option>
Female
</option>

</select>

</div>


<div>

<label>Date of Birth</label>

<input
type="date"
name="dob"
>

</div>


<div>

<label>Class *</label>

<select
name="class_name"
required
>

<option value="">
Select Class
</option>

{% for c in classes %}

<option value="{{ c }}">
{{ c }}
</option>

{% endfor %}

</select>

</div>


<div>

<label>Parent Phone *</label>

<input
name="phone"
required
placeholder="03XXXXXXXXX"
>

</div>


<div>

<label>WhatsApp</label>

<input
name="whatsapp"
placeholder="03XXXXXXXXX"
>

</div>


<div>

<label>Previous School</label>

<input
name="previous_school"
>

</div>


<div class="form-full">

<label>Home Address</label>

<textarea
name="address"
placeholder="Complete home address"
></textarea>

</div>

</div>

<button
class="submit-btn"
type="submit"
>
Submit Admission Application
</button>

</form>

</div>

</section>


<!-- =====================================================
     REGISTRATION BLOCK
===================================================== -->

<section id="registration">

<h2 class="section-title">
Student Registration
</h2>

<p class="section-text">
Use this separate form for student registration.
</p>

<div class="form-box">

<form
method="POST"
action="/submit-registration"
>

<div class="form-grid">

<div>

<label>Student Name *</label>

<input
name="student_name"
required
>

</div>

<div>

<label>Father Name *</label>

<input
name="father_name"
required
>

</div>

<div>

<label>Class *</label>

<select
name="class_name"
required
>

<option value="">
Select Class
</option>

{% for c in classes %}

<option value="{{ c }}">
{{ c }}
</option>

{% endfor %}

</select>

</div>

<div>

<label>Parent Phone *</label>

<input
name="phone"
required
>

</div>

<div class="form-full">

<label>Home Address</label>

<textarea
name="address"
></textarea>

</div>

<div>

<label>Emergency Contact</label>

<input
name="emergency_contact"
>

</div>

</div>

<button
class="submit-btn"
type="submit"
>
Submit Student Registration
</button>

</form>

</div>

</section>


<!-- =====================================================
     TEACHER BLOCK
===================================================== -->

<section
id="teachers"
class="form-section"
>

<h2 class="section-title">
Teacher Application
</h2>

<p class="section-text">
Qualified teachers can submit their application.
Master-level qualification is preferred.
</p>

<div class="form-box">

<form
method="POST"
action="/submit-teacher"
>

<div class="form-grid">

<div>

<label>Teacher Name *</label>

<input
name="teacher_name"
required
>

</div>

<div>

<label>Qualification *</label>

<input
name="qualification"
required
placeholder="M.A, M.Sc, M.Ed etc."
>

</div>

<div>

<label>Subject *</label>

<input
name="subject"
required
>

</div>

<div>

<label>Phone *</label>

<input
name="phone"
required
>

</div>

<div>

<label>Teaching Experience</label>

<input
name="experience"
placeholder="Example: 3 years"
>

</div>

<div>

<label>Demo Topic</label>

<input
name="demo_topic"
>

</div>

</div>

<button
class="submit-btn"
type="submit"
>
Submit Teacher Application
</button>

</form>

</div>

</section>


<!-- =====================================================
     TEACHER DEMO BLOCK
===================================================== -->

<section id="demo">

<h2 class="section-title">
Teacher Demo
</h2>

<p class="section-text">
Teachers can separately request a demo date and time.
</p>

<div class="form-box">

<form
method="POST"
action="/submit-demo"
>

<div class="form-grid">

<div>

<label>Teacher Name *</label>

<input
name="teacher_name"
required
>

</div>

<div>

<label>Subject *</label>

<input
name="subject"
required
>

</div>

<div>

<label>Demo Topic *</label>

<input
name="topic"
required
>

</div>

<div>

<label>Phone *</label>

<input
name="phone"
required
>

</div>

<div>

<label>Demo Date</label>

<input
type="date"
name="demo_date"
>

</div>

<div>

<label>Demo Time</label>

<input
type="time"
name="demo_time"
>

</div>

</div>

<button
class="submit-btn"
type="submit"
>
Submit Demo Request
</button>

</form>

</div>

</section>


<!-- =====================================================
     PAYMENT BLOCK
===================================================== -->

<section
id="payment"
class="payment"
>

<h2 class="section-title">
JazzCash Payment
</h2>

<p class="section-text">
Send the payment to the school's JazzCash number,
then submit the transaction ID below for verification.
</p>


<div class="grid">


<div class="payment-card">

<h3>
💳 JazzCash Number
</h3>

<div class="payment-number">
{{ jazzcash }}
</div>

<p>
School JazzCash account
</p>

</div>


<div class="payment-card">

<h3>
🎓 Admission Fee
</h3>

<div class="payment-number">
Rs. {{ admission_fee }}
</div>

</div>


<div class="payment-card">

<h3>
📅 Monthly Fee
</h3>

<div class="payment-number">
Rs. {{ monthly_fee }}
</div>

</div>

</div>


<br><br>


<div class="form-box">

<h2>
Submit Transaction
</h2>

<p style="margin:15px 0;">
After making your JazzCash payment to
<strong>{{ jazzcash }}</strong>,
enter the transaction information here.
</p>

<form
method="POST"
action="/submit-payment"
>

<div class="form-grid">

<div>

<label>Student Name *</label>

<input
name="student_name"
required
>

</div>


<div>

<label>Parent Phone *</label>

<input
name="phone"
required
>

</div>


<div>

<label>Application ID</label>

<input
name="application_id"
placeholder="PPIS-2026..."
>

</div>


<div>

<label>Amount *</label>

<input
type="number"
name="amount"
min="1"
required
>

</div>


<div>

<label>Payment Type *</label>

<select
name="payment_type"
required
>

<option value="">
Select
</option>

<option>
Admission Fee
</option>

<option>
Monthly Fee
</option>

<option>
Other School Fee
</option>

</select>

</div>


<div>

<label>JazzCash Transaction ID *</label>

<input
name="transaction_id"
required
placeholder="Enter transaction ID"
>

</div>

</div>


<button
class="submit-btn"
type="submit"
>
Submit Transaction
</button>

</form>

</div>

</section>


<!-- =====================================================
     FEATURES BLOCK
===================================================== -->

<section>

<h2 class="section-title">
School Services
</h2>

<p class="section-text">
Each service has its own dedicated section.
</p>

<div class="grid">

<div class="card">

<div class="card-icon">
📝
</div>

<h3>
Online Admission
</h3>

<p>
Parents can apply online from home.
</p>

</div>


<div class="card">

<div class="card-icon">
🧑‍🎓
</div>

<h3>
Student Registration
</h3>

<p>
Separate student registration system.
</p>

</div>


<div class="card">

<div class="card-icon">
👨‍🏫
</div>

<h3>
Teacher Recruitment
</h3>

<p>
Separate teacher application system.
</p>

</div>


<div class="card">

<div class="card-icon">
🎥
</div>

<h3>
Teacher Demo
</h3>

<p>
Teachers can submit their demo request.
</p>

</div>


<div class="card">

<div class="card-icon">
💳
</div>

<h3>
JazzCash Payment
</h3>

<p>
Submit your JazzCash transaction ID.
</p>

</div>


<div class="card">

<div class="card-icon">
📩
</div>

<h3>
Contact School
</h3>

<p>
Send a message directly through the website.
</p>

</div>

</div>

</section>


<!-- =====================================================
     CONTACT BLOCK
===================================================== -->

<section
id="contact"
style="background:#eef6fa;"
>

<h2 class="section-title">
Contact School
</h2>

<p class="section-text">
Contact {{ school_name }} for admission and school information.
</p>


<div class="grid">


<div class="card contact-card">

<div class="card-icon">
📱
</div>

<h3>
WhatsApp
</h3>

<div class="contact-number">
{{ whatsapp }}
</div>

<a
class="btn btn-dark"
href="https://wa.me/92{{ whatsapp[1:] }}"
target="_blank"
>
Open WhatsApp
</a>

</div>


<div class="card contact-card">

<div class="card-icon">
☎️
</div>

<h3>
School Call
</h3>

<div class="contact-number">
{{ call_number }}
</div>

<a
class="btn btn-dark"
href="tel:{{ call_number }}"
>
