# =========================================================
# JAZZCASH PAYMENT
# =========================================================

@app.route("/submit-payment", methods=["POST"])
def submit_payment():

    student_name = request.form.get("student_name", "").strip()
    application_id = request.form.get("application_id", "").strip()
    phone = request.form.get("phone", "").strip()
    amount = request.form.get("amount", "").strip()
    payment_type = request.form.get("payment_type", "").strip()
    transaction_id = request.form.get("transaction_id", "").strip()

    if not student_name or not phone or not amount or not payment_type or not transaction_id:
        return "Please complete all payment fields.", 400

    try:
        amount = int(amount)

        if amount <= 0:
            raise ValueError

    except ValueError:
        return "Invalid amount.", 400

    payment_id = create_id("PAY")

    db = get_db()

    db.execute("""
        INSERT INTO payments
        (
            payment_id,
            student_name,
            application_id,
            phone,
            amount,
            payment_type,
            jazzcash_number,
            transaction_id,
            status,
            created_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        payment_id,
        student_name,
        application_id,
        phone,
        amount,
        payment_type,
        JAZZCASH,
        transaction_id,
        "Pending",
        datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    ))

    db.commit()
    db.close()

    return render_template_string(
        SUCCESS_PAGE,
        title="Payment Submitted",
        message="Your JazzCash transaction has been sent for verification.",
        reference=payment_id
    )


# =========================================================
# CONTACT FORM
# =========================================================

@app.route("/submit-message", methods=["POST"])
def submit_message():

    name = request.form.get("name", "").strip()
    phone = request.form.get("phone", "").strip()
    email = request.form.get("email", "").strip()
    subject = request.form.get("subject", "").strip()
    message = request.form.get("message", "").strip()

    if not name or not phone or not message:
        return "Please complete required fields.", 400

    message_id = create_id("MSG")

    db = get_db()

    db.execute("""
        INSERT INTO messages
        (
            message_id,
            name,
            phone,
            email,
            subject,
            message,
            created_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?)
    """, (
        message_id,
        name,
        phone,
        email,
        subject,
        message,
        datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    ))

    db.commit()
    db.close()

    return render_template_string(
        SUCCESS_PAGE,
        title="Message Sent",
        message="Your message has been received by the school.",
        reference=message_id
    )


# =========================================================
# ADMIN LOGIN
# =========================================================

@app.route("/admin-login", methods=["GET", "POST"])
def admin_login():

    if request.method == "POST":

        password = request.form.get("password", "")

        admin_password = os.environ.get(
            "ADMIN_PASSWORD",
            "PPIS-Admin-123"
        )

        if password == admin_password:

            session["admin"] = True

            return redirect(url_for("admin"))

        return render_template_string(
            LOGIN_PAGE,
            error="Wrong password."
        )

    return render_template_string(
        LOGIN_PAGE,
        error=""
    )


# =========================================================
# ADMIN DASHBOARD
# =========================================================

@app.route("/admin")
def admin():

    if not session.get("admin"):
        return redirect(url_for("admin_login"))

    db = get_db()

    admissions = db.execute(
        "SELECT * FROM admissions ORDER BY id DESC"
    ).fetchall()

    registrations = db.execute(
        "SELECT * FROM registrations ORDER BY id DESC"
    ).fetchall()

    teachers = db.execute(
        "SELECT * FROM teachers ORDER BY id DESC"
    ).fetchall()

    demos = db.execute(
        "SELECT * FROM demos ORDER BY id DESC"
    ).fetchall()

    payments = db.execute(
        "SELECT * FROM payments ORDER BY id DESC"
    ).fetchall()

    messages = db.execute(
        "SELECT * FROM messages ORDER BY id DESC"
    ).fetchall()

    db.close()

    return render_template_string(
        ADMIN_PAGE,
        admissions=admissions,
        registrations=registrations,
        teachers=teachers,
        demos=demos,
        payments=payments,
        messages=messages,
        jazzcash=JAZZCASH
    )


# =========================================================
# PAYMENT STATUS
# =========================================================

@app.route("/payment-status/<int:payment_id>/<status>")
def payment_status(payment_id, status):

    if not session.get("admin"):
        return redirect(url_for("admin_login"))

    if status not in ["Pending", "Verified", "Rejected"]:
        return "Invalid status.", 400

    db = get_db()

    db.execute(
        "UPDATE payments SET status=? WHERE id=?",
        (status, payment_id)
    )

    db.commit()
    db.close()

    return redirect(url_for("admin"))


# =========================================================
# LOGOUT
# =========================================================

@app.route("/logout")
def logout():

    session.clear()

    return redirect(url_for("home"))


