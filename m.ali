</a>

</div>


<div class="card contact-card">

<div class="card-icon">
📍
</div>

<h3>
Location
</h3>

<p>
{{ location }}
</p>

</div>

</div>

</section>


<!-- =====================================================
     MESSAGE BLOCK
===================================================== -->

<section>

<h2 class="section-title">
Send Us a Message
</h2>

<p class="section-text">
Have a question? Send the school a message.
</p>

<div class="form-box">

<form
method="POST"
action="/submit-message"
>

<div class="form-grid">

<div>

<label>Name *</label>

<input
name="name"
required
>

</div>


<div>

<label>Phone *</label>

<input
name="phone"
required
>

</div>


<div>

<label>Email</label>

<input
type="email"
name="email"
>

</div>


<div>

<label>Subject</label>

<input
name="subject"
>

</div>


<div class="form-full">

<label>Message *</label>

<textarea
name="message"
required
></textarea>

</div>

</div>

<button
class="submit-btn"
type="submit"
>
Submit Message
</button>

</form>

</div>

</section>


<!-- =====================================================
     FOOTER
===================================================== -->

