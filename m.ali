from flask import Flask, request, redirect, url_for, render_template_string, session
import sqlite3
from datetime import datetime
import secrets
import os

app = Flask(__name__)

# ---------------------------------------------------------
# SECURITY SETTINGS
# ---------------------------------------------------------

app.secret_key = os.environ.get(
    "SECRET_KEY",
    "CHANGE_THIS_SECRET_KEY_BEFORE_DEPLOYMENT"
)

DATABASE = "pak_peace_school.db"

# ---------------------------------------------------------
# SCHOOL INFORMATION
# ---------------------------------------------------------

SCHOOL_NAME = "PAK Peace International School"
SCHOOL_TYPE = "Private School"

WHATSAPP = "03047073762"
CALL_NUMBER = "03046667171"
JAZZCASH = "03046667171"

LOCATION = "Qasba Maral, Near Multan, Punjab, Pakistan"

ADMISSION_FEE = 2000
MONTHLY_FEE = 2000

# IMPORTANT:
# NO FOUNDATION
# ONLY PLAY GROUP TO CLASS 7

CLASSES = [
    "Play Group",
    "Nursery",
    "Prep",
    "Class 1",
    "Class 2",
    "Class 3",
    "Class 4",
    "Class 5",
    "Class 6",
    "Class 7"
]


# =========================================================
# DATABASE
# =========================================================

def get_db():
    db = sqlite3.connect(DATABASE)
    db.row_factory = sqlite3.Row
    return db


def init_database():

    db = get_db()

    # -----------------------------------------------------
    # ADMISSIONS
    # -----------------------------------------------------

    db.execute("""
        CREATE TABLE IF NOT EXISTS admissions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            application_id TEXT UNIQUE,
            student_name TEXT NOT NULL,
            father_name TEXT NOT NULL,
            gender TEXT,
            date_of_birth TEXT,
            class_name TEXT NOT NULL,
            phone TEXT NOT NULL,
            whatsapp TEXT,
            address TEXT,
            previous_school TEXT,
            created_at TEXT
        )
    """)

    # -----------------------------------------------------
    # STUDENT REGISTRATION
    # -----------------------------------------------------

    db.execute("""
        CREATE TABLE IF NOT EXISTS registrations (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            registration_id TEXT UNIQUE,
            student_name TEXT NOT NULL,
            father_name TEXT NOT NULL,
            class_name TEXT NOT NULL,
            phone TEXT NOT NULL,
            address TEXT,
            emergency_contact TEXT,
            created_at TEXT
        )
    """)

    # -----------------------------------------------------
    # TEACHERS
    # -----------------------------------------------------

    db.execute("""
        CREATE TABLE IF NOT EXISTS teachers (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            teacher_id TEXT UNIQUE,
            teacher_name TEXT NOT NULL,
            qualification TEXT NOT NULL,
            subject TEXT NOT NULL,
            phone TEXT NOT NULL,
            experience TEXT,
            demo_topic TEXT,
            created_at TEXT
        )
    """)

    # -----------------------------------------------------
    # DEMO CLASSES
    # -----------------------------------------------------

    db.execute("""
        CREATE TABLE IF NOT EXISTS demos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            demo_id TEXT UNIQUE,
            teacher_name TEXT NOT NULL,
            subject TEXT NOT NULL,
            topic TEXT NOT NULL,
            demo_date TEXT,
            demo_time TEXT,
            phone TEXT NOT NULL,
            created_at TEXT
        )
    """)

    # -----------------------------------------------------
    # PAYMENTS
    # -----------------------------------------------------

    db.execute("""
        CREATE TABLE IF NOT EXISTS payments (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            payment_id TEXT UNIQUE,
            student_name TEXT NOT NULL,
            application_id TEXT,
            phone TEXT NOT NULL,
            amount INTEGER NOT NULL,
            payment_type TEXT NOT NULL,
            jazzcash_number TEXT NOT NULL,
            transaction_id TEXT NOT NULL,
            status TEXT DEFAULT 'Pending',
            created_at TEXT
        )
    """)

    # -----------------------------------------------------
    # CONTACT MESSAGES
    # -----------------------------------------------------

    db.execute("""
        CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            message_id TEXT UNIQUE,
            name TEXT NOT NULL,
            phone TEXT NOT NULL,
            email TEXT,
            subject TEXT,
            message TEXT NOT NULL,
            created_at TEXT
        )
    """)

    db.commit()
    db.close()


# =========================================================
# ID GENERATOR
# =========================================================

def create_id(prefix):

    date = datetime.now().strftime("%Y%m%d")
    number = secrets.randbelow(9000) + 1000

    return f"{prefix}-{date}-{number}"


# =========================================================
# HOME
# =========================================================

@app.route("/")
def home():

    return render_template_string(
        HOME_PAGE,
        school_name=SCHOOL_NAME,
        school_type=SCHOOL_TYPE,
        classes=CLASSES,
        whatsapp=WHATSAPP,
        call_number=CALL_NUMBER,
        jazzcash=JAZZCASH,
        location=LOCATION,
        admission_fee=ADMISSION_FEE,
        monthly_fee=MONTHLY_FEE
    )


# =========================================================
# ADMISSION
# =========================================================

@app.route("/submit-admission", methods=["POST"])
def submit_admission():

    student_name = request.form.get("student_name", "").strip()
    father_name = request.form.get("father_name", "").strip()
    gender = request.form.get("gender", "").strip()
    dob = request.form.get("dob", "").strip()
    class_name = request.form.get("class_name", "").strip()
    phone = request.form.get("phone", "").strip()
    whatsapp = request.form.get("whatsapp", "").strip()
    address = request.form.get("address", "").strip()
    previous_school = request.form.get("previous_school", "").strip()

    if not student_name or not father_name or not class_name or not phone:
        return "Required admission fields are missing.", 400

    if class_name not in CLASSES:
        return "Invalid class.", 400

    application_id = create_id("PPIS")

    db = get_db()

    db.execute("""
        INSERT INTO admissions
        (
            application_id,
            student_name,
            father_name,
            gender,
            date_of_birth,
            class_name,
            phone,
            whatsapp,
            address,
            previous_school,
            created_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        application_id,
        student_name,
        father_name,
        gender,
        dob,
        class_name,
        phone,
        whatsapp,
        address,
        previous_school,
        datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    ))

    db.commit()
    db.close()

    return render_template_string(
        SUCCESS_PAGE,
        title="Admission Submitted",
        message="Your online admission application has been submitted successfully.",
        reference=application_id
    )


# =========================================================
# STUDENT REGISTRATION
# =========================================================

@app.route("/submit-registration", methods=["POST"])
def submit_registration():

    student_name = request.form.get("student_name", "").strip()
    father_name = request.form.get("father_name", "").strip()
    class_name = request.form.get("class_name", "").strip()
    phone = request.form.get("phone", "").strip()
    address = request.form.get("address", "").strip()
    emergency = request.form.get("emergency_contact", "").strip()

    if not student_name or not father_name or not class_name or not phone:
        return "Required fields are missing.", 400

    if class_name not in CLASSES:
        return "Invalid class.", 400

    registration_id = create_id("REG")

    db = get_db()

    db.execute("""
        INSERT INTO registrations
        (
            registration_id,
            student_name,
            father_name,
            class_name,
            phone,
            address,
            emergency_contact,
            created_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        registration_id,
        student_name,
        father_name,
        class_name,
        phone,
        address,
        emergency,
        datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    ))

    db.commit()
    db.close()

    return render_template_string(
        SUCCESS_PAGE,
        title="Registration Submitted",
        message="Student registration has been received.",
        reference=registration_id
    )


